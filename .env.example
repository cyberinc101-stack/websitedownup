# Copy this file to .env.local for local development and fill in values.
# .env.local is git-ignored. Never commit real values.

# ---- Public (bundled into the browser; no secrets here) ----
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
# Ad unit ID (data-ad-slot) of a responsive display unit. Ad boxes only show
# once this AND the publisher ID are set; until then they're hidden.
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# ---- SECRET: server-only. Never add a NEXT_PUBLIC_ prefix. ----
# Added automatically on Vercel when you connect Upstash Redis (Storage tab).
KV_REST_API_URL=
KV_REST_API_TOKEN=
